# Copy this file to .env and adjust it. Never commit .env!

# Which model provider to use: "ollama" (default, free & local), "openai" or "watsonx"
LLM_PROVIDER=ollama

# --- Ollama (free, runs on your computer: https://ollama.com) ---
# Download the model first:  ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (paid API key) ---
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-5.4-nano

# --- IBM watsonx.ai (needs: pip install langchain-ibm) ---
# WATSONX_APIKEY=your-watsonx-api-key
# WATSONX_PROJECT_ID=your-project-id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-4-h-small
